# Binance Configuration
BNS_UUID="your_bns_uuid_here"
PORTFOLIO_IDS="your_portfolio_id_1,your_portfolio_id_2" # Comma-separated

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017/binance_copy_trades_python"
DB_NAME="binance_copy_trades_python" # Optional: Or derive from MONGODB_URI
TRADE_COLLECTION_NAME="trades"

# Job Configuration
FETCH_INTERVAL_MINUTES="5" # Interval for fetching data in minutes
FETCH_WINDOW_MINUTES="10"  # Duration of the time window for fetching trades (e.g., last 10 minutes)
INITIAL_JOB_DELAY_SECONDS="10" # Delay for the first job run after startup

# Logging Configuration
LOG_LEVEL="INFO" # e.g., DEBUG, INFO, WARNING, ERROR
LOG_FILE_APP="logs/app.log"
LOG_FILE_ERROR="logs/error.log"
